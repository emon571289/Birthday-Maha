```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday Momo ❤️</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    font-family: Arial, sans-serif;
    color: white;
    text-align: center;
    overflow-x: hidden;
    background: linear-gradient(135deg, #1e1b4b, #86198f, #ec4899);
}

.card {
    width: 100%;
    max-width: 550px;
    padding: 35px 22px;
    border-radius: 25px;
    background: rgba(255,255,255,0.13);
    border: 1px solid rgba(255,255,255,0.3);
    box-shadow: 0 15px 50px rgba(0,0,0,0.3);
    backdrop-filter: blur(12px);
    animation: appear 1s ease;
}

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

h1 {
    font-size: clamp(32px, 8vw, 48px);
    color: #ffe4ef;
    margin-bottom: 15px;
    text-shadow: 0 0 20px #ff69b4;
}

.name {
    color: #ffd166;
    font-size: clamp(23px, 6vw, 32px);
    font-weight: bold;
    overflow-wrap: anywhere;
}

.cake {
    font-size: 95px;
    margin: 20px 0;
    animation: bounce 2s infinite;
}

@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
}

.message {
    font-size: 17px;
    line-height: 1.8;
    margin: 20px auto;
}

.love {
    color: #ffd6e7;
    font-size: 20px;
    font-weight: bold;
    margin-top: 15px;
}

button {
    margin-top: 25px;
    padding: 15px 28px;
    border: none;
    border-radius: 50px;
    background: linear-gradient(45deg, #ff4d94, #ff85b3);
    color: white;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 5px 20px rgba(255,77,148,0.4);
    transition: transform 0.2s;
}

button:hover {
    transform: scale(1.06);
}

button:active {
    transform: scale(0.96);
}

.footer {
    margin-top: 25px;
    font-size: 13px;
    opacity: 0.8;
}

.heart {
    position: fixed;
    bottom: -30px;
    pointer-events: none;
    animation: floatUp linear forwards;
    z-index: -1;
}

@keyframes floatUp {
    to {
        transform: translateY(-110vh) rotate(360deg);
        opacity: 0;
    }
}

canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
}

@media (max-width: 400px) {
    .card {
        padding: 28px 17px;
    }

    .message {
        font-size: 15px;
    }

    .cake {
        font-size: 75px;
    }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
    }
}
</style>
</head>

<body>

<canvas id="confetti"></canvas>

<div class="card">

    <h1>🎉 Happy Birthday 🎉</h1>

    <p class="name">Israt Jahan Momo ❤️</p>

    <div class="cake">🎂</div>

    <p class="message">
        My dearest Momo! 💖<br><br>

        Happy Birthday to the most special girl in my life! 🌹

        You make my world brighter just by being in it.
        Your smile is my happiness, and your presence
        makes every moment beautiful. 🥹❤️

        May all your dreams come true, may your life
        be filled with endless happiness, and may you
        always keep smiling.

        You deserve all the love and happiness
        in this universe. 💕
    </p>

    <p class="love">
        I Love You So Much, Momo! ❤️🌹
    </p>

    <p style="margin-top:15px;">
        You are my favorite person forever. 🫶
    </p>

    <button onclick="celebrate()">
        🎉 Celebrate, Momo! 🎉
    </button>

    <p class="footer">
        Made with ❤️ especially for Israt Jahan Momo
    </p>

</div>

<script>
const canvas = document.getElementById("confetti");
const ctx = canvas.getContext("2d");

let pieces = [];
let frame = null;

function resizeCanvas() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    canvas.width = window.innerWidth * dpr;
    canvas.height = window.innerHeight * dpr;

    canvas.style.width = window.innerWidth + "px";
    canvas.style.height = window.innerHeight + "px";

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}

window.addEventListener("resize", resizeCanvas);
resizeCanvas();

function celebrate() {
    const colors = [
        "#ff4d94",
        "#ffd166",
        "#a78bfa",
        "#60a5fa",
        "#86efac",
        "#ffffff"
    ];

    for (let i = 0; i < 180; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 2 + Math.random() * 6;

        pieces.push({
            x: window.innerWidth / 2,
            y: window.innerHeight * 0.4,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed - 2,
            gravity: 0.12,
            size: 4 + Math.random() * 6,
            rotation: Math.random() * 6,
            spin: (Math.random() - 0.5) * 0.2,
            color: colors[Math.floor(Math.random() * colors.length)],
            life: 120 + Math.random() * 60
        });
    }

    if (!frame) animate();
}

function animate() {
    ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

    pieces = pieces.filter(p => p.life > 0 && p.y < window.innerHeight + 30);

    pieces.forEach(p => {
        p.x += p.vx;
        p.y += p.vy;
        p.vy += p.gravity;
        p.rotation += p.spin;
        p.life--;

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rotation);
        ctx.globalAlpha = Math.min(1, p.life / 25);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.7);
        ctx.restore();
    });

    if (pieces.length > 0) {
        frame = requestAnimationFrame(animate);
    } else {
        frame = null;
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
    }
}

// Floating hearts in the background
function createHeart() {
    const heart = document.createElement("div");

    heart.className = "heart";
    heart.textContent = ["❤️", "💕", "💖", "💗", "🌹"][
        Math.floor(Math.random() * 5)
    ];

    heart.style.left = Math.random() * 100 + "vw";
    heart.style.fontSize = (16 + Math.random() * 20) + "px";
    heart.style.animationDuration = (5 + Math.random() * 5) + "s";

    document.body.appendChild(heart);

    setTimeout(() => heart.remove(), 10000);
}

// Welcome confetti when the page opens
window.addEventListener("load", () => {
    setTimeout(celebrate, 500);
});

setInterval(createHeart, 700);
</script>

</body>
</html>
```